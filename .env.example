# Host advertised to the ESP32 in OTA JSON (not the bind address).
ADVERTISE_HOST=192.168.50.188

# Device-facing ports — keep these unless you re-provision the board.
OTA_PORT=8002
WS_PORT=8000

# Next.js dashboard
UI_PORT=3000

# Qwen-Omni Realtime (Bailian). Leave empty to keep the local stub path.
# Required to enable live duplex voice: API key + workspace id (or DASHSCOPE_REALTIME_URL).
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REALTIME_MODEL=qwen3.5-omni-flash-realtime
DASHSCOPE_REALTIME_VOICE=Tina
# Optional full wss URL override. If omitted, built from workspace + Beijing host.
DASHSCOPE_REALTIME_URL=
# Optional system instructions for the desktop-robot persona.
DASHSCOPE_INSTRUCTIONS=
